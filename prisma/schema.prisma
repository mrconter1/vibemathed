// VibeMathed database.
//
// Entries used to live only in `src/data/problems.json`, which made git the
// audit log for every curation change. Now that problems live here - and that
// users will be able to submit their own - that history has to be recorded
// explicitly, hence `ProblemActivity`. `problems.json` stays in the repo as the
// seed source (see `prisma/seed.ts`), so a fresh database is always one
// `npm run db:seed` away from the curated baseline.
//
// LENGTH CAPS - DO NOT APPLY THESE WITH `prisma db push`.
//
// The `@db.String(n)` annotations below mirror the `maxLength` on the field
// specs in src/lib/editable.ts, so a curator script writing through Prisma is
// refused by the database rather than only by the edit form.
// `scripts/check-field-limits.ts` fails if the two ever disagree.
//
// They must be applied with prisma/manual/2026-08-13-field-length-caps.sql.
// Prisma's cockroachdb connector cannot narrow STRING to STRING(n) in place:
// asked to, it emits DROP COLUMN followed by ADD COLUMN, which silently
// discards the contents of every affected column. The manual file uses
// ALTER COLUMN ... TYPE, which keeps the data.
//
// Naming note: `solveType` and `verification` are stored as plain strings
// rather than Postgres enums on purpose. Their vocabularies are curated and
// still moving (the verification "trust ladder" gains tiers), and the existing
// validator in `src/lib/problems.ts` already rejects unknown values on the way
// in - so a new tier costs a seed run, not a schema migration. The vocabularies
// that are genuinely closed (`VoteKind`, `ProblemStatus`, `ActivityType`) are
// real enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // CockroachDB serverless - the same stone-grivet cluster wilhelm-scream-db
  // runs on, but a separate `vibemathed` database within it.
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum VoteKind {
  up
  down
}

enum ProblemStatus {
  /// Curated and publicly listed.
  published
  /// User-submitted, awaiting review. Never listed publicly.
  pending
  /// Reviewed and turned down. Kept so the submitter can see the outcome.
  rejected
}

enum ActivityType {
  created
  updated
  submitted
  approved
  rejected
  voted
  unvoted
  commented
}

enum ReportStatus {
  /// Waiting for a curator to look at it.
  open
  /// A curator has seen it and acted (or decided no action was needed).
  handled
}

model Problem {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique

  name      String @db.String(200)
  /// Compact label for chart axes / narrow layouts.
  shortName String @db.String(60)
  /// Erdős problem number, if this is one.
  problemNumber Int?
  field         String? @db.String(80)
  /// Normalized field bucket for filtering (one of FIELD_GROUPS in
  /// src/lib/problems.ts - AIM-compatible taxonomy). `field` stays free text
  /// for the card detail line; this is what the filter chips group by.
  fieldGroup    String?
  /// Plain-language statement. Only ~1 in 5 entries has one; the card layout
  /// must not reserve space for it.
  statement     String? @db.String(1200)
  posedBy       String? @db.String(200)
  yearPosed     Int?
  /// "proved" | "disproved" - see the naming note at the top of this file.
  solveType     String
  /// ISO date, or "YYYY-MM" / "YYYY". For date ranges, the completion date.
  solveDate     String
  model         String @db.String(120)
  modelMaker    String? @db.String(120)
  humanCollaborators String[]
  /// What the model did. Sparse, like `statement`.
  aiRole        String? @db.String(1500)
  /// How CHECKED the mathematics is: "lean-verified" | "expert-verified" |
  /// "site-confirmed" | "lean-checked" | "unreviewed" | "contested".
  /// lean-verified requires the formal statement to be independently
  /// anchored; lean-checked means the artifact compiles but nobody
  /// independent audited the informal-to-formal correspondence. Orthogonal to
  /// `publication` - the old single ladder conflated the two.
  verification  String
  verificationNote String? @db.String(1500)
  /// Where the claim lives: "announcement" | "preprint" | "peer-reviewed".
  publication   String?
  /// How the resolution was achieved: "construction" | "computation" |
  /// "argument". Null = not yet classified.
  resolutionMethod String?
  /// What happened to the PROBLEM, as opposed to how trustworthy the claim is
  /// (`verification`): "resolved" | "partial" | "variant" | "candidate" |
  /// "retracted". Same string-not-enum convention as `solveType`.
  resolution    String  @default("resolved")
  /// When a documented issue exists with the claim (a refuted lemma, a
  /// misformalized Lean statement), the note explaining it. Renders as a
  /// visible flag on the entry.
  claimIssueNote String? @db.String(1000)
  /// How much of the mathematics the model actually contributed:
  /// "ai-discovered" | "ai-co-developed" | "ai-assisted". Same string-not-enum
  /// convention as `solveType`. Null on entries not yet classified (the axis
  /// postdates most of the catalog); below "ai-assisted" is out of scope
  /// entirely - see the methodology page.
  aiContribution String?

  citations       Int?
  citationsPaper  String? @db.String(300)
  citationsSource String? @db.String(120)
  citationsUrl    String?

  /// Renown proxy: Wikipedia language editions with an article dedicated to
  /// THIS problem. 0 means "no dedicated article", not "unknown".
  renownLangs Int     @default(0)
  renownNote  String? @db.String(300)
  /// AI-estimated significance of the PROBLEM as it stood before the solve,
  /// an integer 0-100 against the anchored ladder in the methodology
  /// (Riemann hypothesis = 100) and, since prompt v2, placed comparatively
  /// against a fixed spine of catalog anchors - one-point resolution is
  /// earned by comparison, not claimed in isolation. Curator measurement
  /// like renownLangs, never self-reported; null = not yet assessed. Scored
  /// with the published prompt in public/significance-prompt.md (served at
  /// /significance-prompt.md).
  significance     Int?
  /// One-line justification for the score, shown on the entry page.
  significanceNote String? @db.String(600)
  /// Disclosed cost of producing the result, in whole US dollars. Almost
  /// always null: labs and authors rarely publish what a solve cost, and an
  /// undisclosed cost must never be guessed. Where a source gives only an
  /// aggregate over several results, the note says so.
  solveCostUsd  Int?
  /// What the figure covers and where it came from; shown beside the number.
  solveCostNote String? @db.String(300)
  resultNote  String? @db.String(1000)
  ageNote     String? @db.String(400)
  sourceUrl  String
  sourceName String @db.String(200)
  /// Free text from the submitter to the reviewer, fixed at submission like
  /// `solveType` and `problemNumber` - not one of EDITABLE_FIELDS, so nobody
  /// edits it afterwards and it never appears on the published entry.
  ///
  /// Every other note field on this model becomes part of the entry itself:
  /// `resultNote` is a public qualifier, `claimIssueNote` renders as a visible
  /// flag. This one exists because a submitter can hold information that
  /// belongs to neither category - "the catalog already has a related entry",
  /// "I could not find a DOI" - context for the review, not content about the
  /// mathematics. Shown only in /admin/submissions and the pending preview.
  submitterNote String? @db.String(1000)
  status        ProblemStatus @default(published)
  /// When a curator approved or rejected this submission, and the message
  /// they left for the submitter. The message reaches the submitter through
  /// their notifications and is not public: a rejection reason is feedback
  /// for one person, not a changelog entry.
  reviewedAt     DateTime?
  reviewMessage  String? @db.String(2000)
  /// The canned reason the reviewer picked, one of REVIEW_REASONS in
  /// src/lib/messages.ts. Kept beside the free-text message rather than folded
  /// into it so decisions stay countable: "how often do we turn things down as
  /// duplicates" is a question about the queue, not about prose.
  reviewReason   String?
  submittedById String?
  submittedBy   User?         @relation("ProblemSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  /// Denormalized vote tallies, kept in step with `votes` inside a transaction
  /// so listing 75 cards never fans out into 75 aggregate queries.
  upvotes   Int @default(0)
  downvotes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  votes      ProblemVote[]
  comments   Comment[]
  activities ProblemActivity[]
  links      ProblemLink[]
  reports    ProblemReport[]
  reviewNotes ReviewNote[]
  provenance  FieldProvenance[]
  messages   DirectMessage[]
  recordRows  RecordRow[]
  relationsFrom ProblemRelation[] @relation("RelationFrom")
  relationsTo   ProblemRelation[] @relation("RelationTo")

  @@index([status])
  @@index([solveDate])
  /// The list read's exact shape: published rows ordered by solve date.
  @@index([status, solveDate])
  @@index([submittedById])
}

/// Additional sources beyond an entry's primary one - Lean repositories,
/// independent proofs of the same theorem, verifiers, community records.
///
/// A real table rather than a JSON column: links are edited individually in
/// the UI, need a stable display order, and should die with their entry
/// (hence the cascade). Rewritten wholesale on edit, so no natural key is
/// needed beyond the position.
model ProblemLink {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  label     String @db.String(120)
  url       String
  /// What the link IS: one of LINK_KINDS in src/lib/link-kinds.ts. Separate
  /// from `label`, which stays free text for the specifics ("Lean proof" is
  /// the kind, "Kitamura's formalization of Theorem 1.1(a)" is the label).
  /// Drives the icon, the grouping on the entry page, and eventually
  /// filtering, none of which a free-text label could support.
  kind      String  @default("other")
  /// Display order within the entry, 0-based.
  position  Int     @default(0)

  @@index([problemId])
}

/// A typed edge between two entries - "Part III continues Part II", "the same
/// work resolves both". ONE directed row rendered from both sides: the `from`
/// entry shows the kind's forward label, the `to` entry its inverse (see
/// src/lib/relation-kinds.ts). Owned, for editing, by the `from` side: an
/// entry's edit dialog manages its outgoing rows, and the incoming ones are
/// edited from the other entry - which is what keeps ownership unambiguous
/// while both pages render the edge.
///
/// `note` is the required why: it renders in the hover card next to the
/// target's name, and a relation without a stated reason is exactly the
/// noise that makes relation graphs useless. Plain text, never math - it
/// shows in a client-side bubble, which cannot run KaTeX.
model ProblemRelation {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromId String  @db.Uuid
  from   Problem @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String  @db.Uuid
  to     Problem @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)
  /// One of RELATION_KINDS in src/lib/relation-kinds.ts.
  kind   String  @db.String(30)
  note   String  @db.String(200)
  /// Display order among the `from` entry's outgoing relations, 0-based.
  position Int   @default(0)

  createdAt DateTime @default(now())

  @@unique([fromId, toId, kind])
  @@index([fromId])
  @@index([toId])
}

model ProblemVote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problemId String   @db.Uuid
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vote      VoteKind
  createdAt DateTime @default(now())

  /// One vote per person per problem; switching direction updates in place.
  @@unique([problemId, userId])
  @@index([problemId])
  @@index([userId])
}

model Comment {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Exactly one of `problemId` / `recordId` is set: a comment hangs off an
  /// entry or off a record. Two nullable columns rather than two tables,
  /// because threading, voting, editing, deletion, notifications and
  /// moderation are identical for both, and a second set of tables would mean
  /// a second implementation of all of it. src/lib/subject.ts holds the
  /// discriminator the application passes around.
  problemId String?  @db.Uuid
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: Cascade)
  recordId  String?  @db.Uuid
  record    Record?  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Pseudonym snapshot, so a deleted account doesn't orphan the thread.
  userName  String?
  /// PLAIN TEXT, never HTML. Rendered to safe HTML on read by
  /// `src/lib/comment-render.ts`, which escapes everything that is not math.
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  /// Threading. Null is a top-level comment; every comment that existed
  /// before threading arrived (2 Sep 2026) is one, which is the whole
  /// conversion. SetNull rather than Cascade so that hard-deleting a parent
  /// can never take someone else's reply with it - though in practice a
  /// parent with replies is blanked, not deleted (see deleteComment).
  parentId String?   @db.Uuid
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentThread")

  /// Denormalised tallies, moved in the same transaction as the vote row, the
  /// same way Problem.upvotes/downvotes are.
  upvotes   Int @default(0)
  downvotes Int @default(0)
  votes     CommentVote[]

  /// Soft delete, used only when the comment has replies: the body is blanked
  /// and the row kept so the thread under it keeps its shape. A comment with
  /// no replies is deleted outright, as before.
  deletedAt DateTime?

  @@index([problemId])
  @@index([recordId])
  @@index([createdAt])
  @@index([parentId])
}

/// One person's vote on one comment. Mirrors ProblemVote; no activity row,
/// because the changelog is about the entry and a comment vote is not.
model CommentVote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commentId String   @db.Uuid
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vote      VoteKind
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

/// A reader flagging an entry for curator attention. Deliberately NOT public
/// (no activity row, never rendered on the entry): a report is a message to
/// the curators, not a comment, and keeping it private avoids pile-ons.
/// The site's inbox. Anyone can write to the curators through /contact, which
/// is why no personal address is published anywhere on the site. Private by
/// construction - never rendered publicly, no activity row - and it reuses the
/// reports queue shape (open/handled, badge, mark-handled) rather than
/// inventing a second one.
model SiteMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Set when the sender was signed in. Anonymous messages are deliberately
  /// allowed: the people most likely to write - a mathematician who spotted a
  /// wrong entry, a journalist - should not have to make an account first.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Pseudonym snapshot, same convention as Comment.userName.
  userName String?

  /// Whatever reply address the sender chose to type. Optional on purpose;
  /// a message with no way to answer is still worth receiving.
  replyTo String?
  /// One of CONTACT_TOPICS in src/lib/contact.ts. Sorts the queue, nothing more.
  topic String
  /// PLAIN TEXT, straight from the form.
  body String

  status    ReportStatus @default(open)
  createdAt DateTime     @default(now())
  handledAt DateTime?

  /// The badge count and the queue read.
  @@index([status])
  /// The per-account rate limit read.
  @@index([userId, createdAt])
  /// The site-wide flood cap reads by time alone, since anonymous senders
  /// have no id to count against.
  @@index([createdAt])
}

model ProblemReport {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Exactly one of `problemId` / `recordId`, as on Comment. A record's
  /// historical rows assert facts about other people's mathematics, so being
  /// able to flag one is not optional.
  problemId String?  @db.Uuid
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: Cascade)
  recordId  String?  @db.Uuid
  record    Record?  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Pseudonym snapshot, same convention as Comment.userName.
  userName  String?
  /// PLAIN TEXT explanation of the issue, straight from the report form.
  body      String
  status    ReportStatus @default(open)
  createdAt DateTime  @default(now())
  handledAt DateTime?

  /// The admin badge count and queue read.
  @@index([status])
  @@index([problemId])
  @@index([recordId])
  /// The per-user daily rate limit read.
  @@index([userId, createdAt])
}

/// Replaces git history as the record of who changed what.
model ProblemActivity {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Exactly one of `problemId` / `recordId`, as on Comment. A record is
  /// curator-edited and asserts dated facts, so its changelog matters more
  /// than an entry's, not less.
  problemId String?       @db.Uuid
  problem   Problem?     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  recordId  String?  @db.Uuid
  record    Record?  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Pseudonym snapshot at time of action; survives user deletion.
  userName  String?
  type      ActivityType
  /// For `updated`: which field changed, and its before/after.
  field     String?
  oldValue  String?
  newValue  String?
  /// For `voted`.
  vote      VoteKind?
  createdAt DateTime     @default(now())

  @@index([problemId])
  @@index([recordId])
  @@index([createdAt])
}

// Auth.js models.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// The ONLY public identity. Auto-assigned at sign-up and changeable in
  /// settings. The real OAuth name and avatar are never shown anywhere - see
  /// `src/lib/identity.ts`. Nullable only to cover the window before
  /// assignment runs.
  pseudonym String? @unique

  /// When the account was created. Added 2026-07-29; accounts that existed
  /// before then carry that date, not their real sign-up date.
  createdAt DateTime @default(now())

  /// Short self-description shown on the public profile. Plain text, capped
  /// at BIO_MAX characters (see src/lib/pseudonym.ts) - a line about who you
  /// are, not a homepage.
  bio String?

  /// Self-declared relationship to the mathematics: one of MEMBER_ROLES in
  /// src/lib/roles.ts. Unverifiable by construction and shown as a plain
  /// label, which is exactly why `verified` below is a separate, curator-set
  /// flag rather than a stronger wording of this one.
  role String?

  /// Profile links, a fixed named set rather than a free list (see
  /// src/lib/profile-links.ts): validated per kind, no open surface for link
  /// spam, and they double as the evidence the verification flow asks for.
  linkWebsite  String?
  linkArxiv    String?
  linkOrcid    String?
  linkGithub   String?
  linkLinkedin String?

  /// Owner-set visibility of the Google identity on the public profile.
  /// Both default OFF: the pseudonym is the only identity anyone gets
  /// without an explicit choice, and these flags are that choice. Read at
  /// render time - turning one off removes the fact from the page, it was
  /// never copied anywhere.
  showGoogleName  Boolean @default(false)
  showGoogleEmail Boolean @default(false)

  /// Owner-set discoverability. Both default ON, unlike the two flags above,
  /// because neither one publishes anything that was private: a pseudonym is
  /// already on every comment and in the homepage activity feed, and the
  /// profile has always listed comments. Defaulting these off would have
  /// silently emptied existing profiles.
  ///
  /// They control AGGREGATION, which is a real exposure of its own even when
  /// each part is public. `listed` is whether the member appears in the
  /// directory at /users - off keeps the profile reachable, just not
  /// enumerable from one page. `showComments` is whether the profile gathers
  /// their comment history; off leaves every comment exactly where it was
  /// posted, on the entry, under the same pseudonym.
  listed       Boolean @default(true)
  showComments Boolean @default(true)

  /// Curator-set: identity or affiliation was actually checked. Never
  /// self-serve. `verifiedNote` records what was checked, shown on hover.
  verified     Boolean @default(false)
  verifiedNote String?

  /// Curator-set place on the site's team: one of STAFF_ROLES in
  /// src/lib/curators.ts. "admin" and "moderator" carry permissions;
  /// "developer" is a credit. Set only by an admin, never self-serve, and the
  /// ADMIN_EMAILS environment list stays the root of trust above it.
  staffRole String?

  /// Curator-set citation count for a verified researcher, read from a public
  /// source at the time noted in `citationsNote` (e.g. "Google Scholar,
  /// 2 Sep 2026"). Display only; a snapshot, not a live figure.
  citations     Int?
  citationsNote String?

  /// Banned accounts cannot sign in (denied in the signIn callback), and
  /// banning deletes their sessions - so with database sessions they lose all
  /// authenticated abilities at once. Curator-set; no UI.
  banned Boolean @default(false)

  /// Notification watermark: comments relevant to this user (on entries they
  /// submitted or commented on) newer than this are "unread". Computed on
  /// read against this timestamp - no notification rows, no fan-out writes.
  notificationsSeenAt DateTime @default(now())

  /// Inbox watermark, the counterpart of `notificationsSeenAt` for curator
  /// mail. Separate because the two are read in different places and a
  /// glance at the bell should not silently mark an unread letter as read.
  inboxSeenAt DateTime @default(now())

  accounts          Account[]
  sessions          Session[]
  votes             ProblemVote[]
  comments          Comment[]
  activities        ProblemActivity[]
  submittedProblems Problem[]         @relation("ProblemSubmitter")
  reports           ProblemReport[]
  messages          SiteMessage[]
  inbox             DirectMessage[]   @relation("DirectMessageRecipient")
  sentMessages      DirectMessage[]   @relation("DirectMessageSender")
  reviewNotes       ReviewNote[]
  commentVotes      CommentVote[]
}

/// Where a field's current value came from, when a model helped write it
/// (issues #7 and #6). One row per (entry, field), overwritten on each
/// AI-assisted write, so a row describes the value that is showing now.
///
/// This is the site holding itself to the bar it holds papers to: several
/// entries were declined because a disclosure named no model and attributed
/// no step. Recording started 2 Sep 2026; curator prose before that was
/// AI-assisted without a per-field record, which the AI-disclosure page says.
/// A field with no row is therefore "unrecorded", not "human-written".
model FieldProvenance {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problemId String   @db.Uuid
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  /// The MathProblem field name, e.g. "verificationNote".
  field     String
  /// The model that drafted the value, as the curator would name it.
  model     String
  /// What it worked from: a paper, a repository, a thread, a verifier run.
  source    String?
  /// The curator who reviewed and saved the value.
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  @@unique([problemId, field])
}

/// A curator's working note on a submission under review. Internal: shown on
/// the review page only, never on the entry, never to the submitter.
///
/// Exists because review became a shared job. With one curator a note could
/// live in their head; with several, the second reviewer needs to see that the
/// first already checked the source, or is waiting on an author's reply, or
/// thinks the tier is wrong. Comments (public, on published entries) and
/// DirectMessage (to the submitter) are both the wrong channel for that.
model ReviewNote {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Pseudonym snapshot, same reason as Comment.userName.
  userName  String?
  /// Plain text. Curators' shorthand, not a formatting surface.
  body      String
  createdAt DateTime @default(now())

  @@index([problemId])
}

/// A curator writing TO one reader. The mirror of SiteMessage, which carries
/// mail the other way.
///
/// This exists because every other channel the site had was either public
/// (comments) or truncated: a report or a rejection could be acted on, but the
/// only reply reached the reader as a 90-character snippet in the bell menu.
/// Deciding someone's submission or their bug report and then not being able
/// to explain why in full is the gap this closes.
///
/// Rows, unlike the comment notifications, which are computed against a
/// watermark with no rows at all. That asymmetry is deliberate: a comment
/// notification is a view over something already stored, whereas a message
/// has content of its own and nowhere else to live.
model DirectMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The reader it was written to. Cascades: an inbox is meaningless without
  /// its owner.
  userId String
  user   User   @relation("DirectMessageRecipient", fields: [userId], references: [id], onDelete: Cascade)

  /// The curator who wrote it, and a pseudonym snapshot in the same spirit as
  /// Comment.userName so a deleted account does not blank the signature.
  senderId   String?
  sender     User?   @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderName String?

  /// What prompted it: one of MESSAGE_KINDS in src/lib/messages.ts. Labels the
  /// message in the inbox; carries no behaviour.
  kind String

  /// Subject line, set only on roots written in the composer. Curator mail
  /// born from a decision or a report has its context (the kind, the entry)
  /// instead, and replies title nothing, so those stay null.
  subject String?

  /// The canned reason, when the curator picked one. Shown as the message's
  /// headline, with `body` underneath as the human part.
  reason String?

  /// PLAIN TEXT. Never rendered as markdown or HTML: this is curator mail, not
  /// a comment, and it should not become a formatting surface.
  body String

  /// The entry it concerns, when it concerns one. Nullable because a message
  /// about a deleted entry is still worth keeping, and because not every
  /// message has an entry behind it.
  problemId String?  @db.Uuid
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  /// The message this one answers, and always the ROOT of the thread rather
  /// than the immediate parent. A thread here is two people going back and
  /// forth about one decision, so a flat list under one root reads better than
  /// a tree and cannot produce unbounded nesting in the UI. Cascades: a reply
  /// with no thread to belong to is noise.
  ///
  /// Null on a root. Roots come from curators (decisions, report answers,
  /// notes) and, since the composer, from any signed-in reader - see
  /// `startConversation` in src/app/actions/inbox.ts for the rate limits that
  /// keep the open door from becoming a spam vector.
  parentId String?         @db.Uuid
  parent   DirectMessage?  @relation("DirectMessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DirectMessage[] @relation("DirectMessageThread")

  createdAt DateTime @default(now())

  /// When the recipient opened the conversation this message is in. Null means
  /// unread, and drives both the bell count and the marker in the list.
  ///
  /// Per message rather than one watermark on the account, because the inbox
  /// is a list of conversations now: opening one of them says nothing about
  /// whether the others have been read, and a single `User.inboxSeenAt` could
  /// not tell them apart.
  readAt DateTime?

  /// The inbox read and the unread count, both by recipient and recency.
  @@index([userId, createdAt])
  /// The bell's unread count, which asks only for this recipient's null ones.
  @@index([userId, readAt])
  /// Loading a thread's replies in order.
  @@index([parentId, createdAt])
  /// The other half of the inbox read (threads the reader STARTED, where they
  /// are the sender, not the recipient) and the reply rate-limit read. Without
  /// it, both fall back to a table scan.
  @@index([senderId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// A record: one named quantity with a direction and a history of best known
/// values. The site's thesis in one picture - decades of human steps on a
/// bound, then the AI step at the end - so a record exists only once a
/// catalog entry sits on it; historical rows are context for that entry, not
/// content in their own right. Curator-created, never submitted directly.
///
/// `Problem` is untouched: an entry is a row on a record, the record is not a
/// kind of entry. Deleting a record deletes its rows and nothing else.
model Record {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique

  name      String @db.String(120)
  /// Short label for strips and chart titles.
  shortName String @db.String(60)
  /// What the quantity is, TeX allowed: "the exponent $\omega$ of matrix
  /// multiplication", "the proportion of nontrivial zeros on the critical line".
  quantity  String @db.String(300)
  /// Plain-language statement of what the record measures and why it matters.
  statement String? @db.String(1500)
  /// "min" when lower is better (an exponent, an upper bound), "max" when
  /// higher is better (a lower bound, a rank, a proportion).
  direction String @db.String(3)
  field     String? @db.String(80)
  fieldGroup String?
  /// Same 0-100 ladder as Problem.significance, and where that number really
  /// belongs: the importance of the question, not of any one step on it.
  significance     Int?
  significanceNote String? @db.String(600)
  /// How the historical rows were sourced and how far back they go.
  historyNote String? @db.String(600)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  rows       RecordRow[]
  comments   Comment[]
  activities ProblemActivity[]
  reports    ProblemReport[]

  @@index([fieldGroup])
}

/// One point on a record's staircase. Either a catalog entry (problemId set)
/// or a cited historical result (problemId null, sourceUrl required by the
/// seed scripts though not by the schema). The current best is DERIVED from
/// the published rows and their values, never stored: a stored frontier is a
/// second source of truth that goes stale.
model RecordRow {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordId String @db.Uuid
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  /// ISO date, or "YYYY-MM" / "YYYY" when that is all the source gives.
  date String @db.String(10)
  /// The value as written: "$2.371177$", "$\ge 31$", "$\log X\,\log_2 X\,\log_4 X/(\log_3 X)^2$".
  valueTex String @db.String(200)
  /// A compact one-line form of the same value, for the strips on /records
  /// and any other narrow slot. Only expression-valued records need one: a
  /// display fraction is two lines tall and wider than a 160px column, and a
  /// value a reader has to scroll sideways to see is not a value they read.
  /// Falls back to `valueTex` when null.
  valueShortTex String? @db.String(200)
  /// Comparable value where one exists. Null for expressions, which compare by
  /// `rank` instead. A record whose rows all have one sorts by it.
  valueNumeric Float?
  /// Curator-set order among rows with no numeric value; higher is better in
  /// the record's direction. Ignored when valueNumeric is present.
  rank Int?
  /// Who, as a reader would cite them: "Strassen", "Ford, Green, Konyagin,
  /// Maynard and Tao", or the model name for an AI row without an entry.
  attribution String @db.String(200)
  sourceUrl   String?
  /// "published" | "candidate" (a claim under review or held - drawn hollow,
  /// never the frontier) | "historical" (a cited pre-AI result) | "retracted".
  status String @db.String(12) @default("published")
  note   String? @db.String(400)

  /// Set when this row IS a catalog entry; the row then inherits the entry's
  /// model, verification and links on the record page.
  problemId String?  @db.Uuid
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([recordId, problemId])
  @@index([recordId, date])
  @@index([problemId])
}

