// VibeMathed database.
//
// Entries used to live only in `src/data/problems.json`, which made git the
// audit log for every curation change. Now that problems live here - and that
// users will be able to submit their own - that history has to be recorded
// explicitly, hence `ProblemActivity`. `problems.json` stays in the repo as the
// seed source (see `prisma/seed.ts`), so a fresh database is always one
// `npm run db:seed` away from the curated baseline.
//
// Naming note: `solveType` and `verification` are stored as plain strings
// rather than Postgres enums on purpose. Their vocabularies are curated and
// still moving (the verification "trust ladder" gains tiers), and the existing
// validator in `src/lib/problems.ts` already rejects unknown values on the way
// in - so a new tier costs a seed run, not a schema migration. The vocabularies
// that are genuinely closed (`VoteKind`, `ProblemStatus`, `ActivityType`) are
// real enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // CockroachDB serverless - the same stone-grivet cluster wilhelm-scream-db
  // runs on, but a separate `vibemathed` database within it.
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum VoteKind {
  up
  down
}

enum ProblemStatus {
  /// Curated and publicly listed.
  published
  /// User-submitted, awaiting review. Never listed publicly.
  pending
  /// Reviewed and turned down. Kept so the submitter can see the outcome.
  rejected
}

enum ActivityType {
  created
  updated
  submitted
  approved
  rejected
  voted
  unvoted
  commented
}

enum ReportStatus {
  /// Waiting for a curator to look at it.
  open
  /// A curator has seen it and acted (or decided no action was needed).
  handled
}

model Problem {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique

  name      String
  /// Compact label for chart axes / narrow layouts.
  shortName String
  /// Erdős problem number, if this is one.
  problemNumber Int?
  field         String?
  /// Normalized field bucket for filtering (one of FIELD_GROUPS in
  /// src/lib/problems.ts - AIM-compatible taxonomy). `field` stays free text
  /// for the card detail line; this is what the filter chips group by.
  fieldGroup    String?
  /// Plain-language statement. Only ~1 in 5 entries has one; the card layout
  /// must not reserve space for it.
  statement     String?
  posedBy       String?
  yearPosed     Int?
  /// "proved" | "disproved" - see the naming note at the top of this file.
  solveType     String
  /// ISO date, or "YYYY-MM" / "YYYY". For date ranges, the completion date.
  solveDate     String
  model         String
  modelMaker    String?
  humanCollaborators String[]
  /// What the model did. Sparse, like `statement`.
  aiRole        String?
  /// How CHECKED the mathematics is: "lean-verified" | "expert-verified" |
  /// "site-confirmed" | "unreviewed" | "contested". Orthogonal to
  /// `publication` - the old single ladder conflated the two.
  verification  String
  verificationNote String?
  /// Where the claim lives: "announcement" | "preprint" | "peer-reviewed".
  publication   String?
  /// How the resolution was achieved: "construction" | "computation" |
  /// "argument". Null = not yet classified.
  resolutionMethod String?
  /// What happened to the PROBLEM, as opposed to how trustworthy the claim is
  /// (`verification`): "resolved" | "partial" | "variant" | "candidate" |
  /// "retracted". Same string-not-enum convention as `solveType`.
  resolution    String  @default("resolved")
  /// When a documented issue exists with the claim (a refuted lemma, a
  /// misformalized Lean statement), the note explaining it. Renders as a
  /// visible flag on the entry.
  claimIssueNote String?
  /// How much of the mathematics the model actually contributed:
  /// "ai-discovered" | "ai-co-developed" | "ai-assisted". Same string-not-enum
  /// convention as `solveType`. Null on entries not yet classified (the axis
  /// postdates most of the catalog); below "ai-assisted" is out of scope
  /// entirely - see the methodology page.
  aiContribution String?

  citations       Int?
  citationsPaper  String?
  citationsSource String?
  citationsUrl    String?

  /// Renown proxy: Wikipedia language editions with an article dedicated to
  /// THIS problem. 0 means "no dedicated article", not "unknown".
  renownLangs Int     @default(0)
  renownNote  String?
  /// AI-estimated significance of the PROBLEM as it stood before the solve,
  /// 0-100 in steps of 5 against the anchored ladder in the methodology
  /// (Riemann hypothesis = 100). Curator measurement like renownLangs, never
  /// self-reported; null = not yet assessed. Scored with the published prompt
  /// in public/significance-prompt.md (served at /significance-prompt.md).
  significance     Int?
  /// One-line justification for the score, shown on the entry page.
  significanceNote String?
  /// Disclosed cost of producing the result, in whole US dollars. Almost
  /// always null: labs and authors rarely publish what a solve cost, and an
  /// undisclosed cost must never be guessed. Where a source gives only an
  /// aggregate over several results, the note says so.
  solveCostUsd  Int?
  /// What the figure covers and where it came from; shown beside the number.
  solveCostNote String?
  resultNote  String?
  ageNote     String?

  sourceUrl  String
  sourceName String

  status        ProblemStatus @default(published)
  /// When a curator approved or rejected this submission, and the message
  /// they left for the submitter. The message reaches the submitter through
  /// their notifications and is not public: a rejection reason is feedback
  /// for one person, not a changelog entry.
  reviewedAt     DateTime?
  reviewMessage  String?
  /// The canned reason the reviewer picked, one of REVIEW_REASONS in
  /// src/lib/messages.ts. Kept beside the free-text message rather than folded
  /// into it so decisions stay countable: "how often do we turn things down as
  /// duplicates" is a question about the queue, not about prose.
  reviewReason   String?
  submittedById String?
  submittedBy   User?         @relation("ProblemSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  /// Denormalized vote tallies, kept in step with `votes` inside a transaction
  /// so listing 75 cards never fans out into 75 aggregate queries.
  upvotes   Int @default(0)
  downvotes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  votes      ProblemVote[]
  comments   Comment[]
  activities ProblemActivity[]
  links      ProblemLink[]
  reports    ProblemReport[]
  messages   DirectMessage[]

  @@index([status])
  @@index([solveDate])
  /// The list read's exact shape: published rows ordered by solve date.
  @@index([status, solveDate])
  @@index([submittedById])
}

/// Additional sources beyond an entry's primary one - Lean repositories,
/// independent proofs of the same theorem, verifiers, community records.
///
/// A real table rather than a JSON column: links are edited individually in
/// the UI, need a stable display order, and should die with their entry
/// (hence the cascade). Rewritten wholesale on edit, so no natural key is
/// needed beyond the position.
model ProblemLink {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  label     String
  url       String
  /// Display order within the entry, 0-based.
  position  Int     @default(0)

  @@index([problemId])
}

model ProblemVote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problemId String   @db.Uuid
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vote      VoteKind
  createdAt DateTime @default(now())

  /// One vote per person per problem; switching direction updates in place.
  @@unique([problemId, userId])
  @@index([problemId])
  @@index([userId])
}

model Comment {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Pseudonym snapshot, so a deleted account doesn't orphan the thread.
  userName  String?
  /// PLAIN TEXT, never HTML. Rendered to safe HTML on read by
  /// `src/lib/comment-render.ts`, which escapes everything that is not math.
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([problemId])
  @@index([createdAt])
}

/// A reader flagging an entry for curator attention. Deliberately NOT public
/// (no activity row, never rendered on the entry): a report is a message to
/// the curators, not a comment, and keeping it private avoids pile-ons.
/// The site's inbox. Anyone can write to the curators through /contact, which
/// is why no personal address is published anywhere on the site. Private by
/// construction - never rendered publicly, no activity row - and it reuses the
/// reports queue shape (open/handled, badge, mark-handled) rather than
/// inventing a second one.
model SiteMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Set when the sender was signed in. Anonymous messages are deliberately
  /// allowed: the people most likely to write - a mathematician who spotted a
  /// wrong entry, a journalist - should not have to make an account first.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Pseudonym snapshot, same convention as Comment.userName.
  userName String?

  /// Whatever reply address the sender chose to type. Optional on purpose;
  /// a message with no way to answer is still worth receiving.
  replyTo String?
  /// One of CONTACT_TOPICS in src/lib/contact.ts. Sorts the queue, nothing more.
  topic String
  /// PLAIN TEXT, straight from the form.
  body String

  status    ReportStatus @default(open)
  createdAt DateTime     @default(now())
  handledAt DateTime?

  /// The badge count and the queue read.
  @@index([status])
  /// The per-account rate limit read.
  @@index([userId, createdAt])
  /// The site-wide flood cap reads by time alone, since anonymous senders
  /// have no id to count against.
  @@index([createdAt])
}

model ProblemReport {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Pseudonym snapshot, same convention as Comment.userName.
  userName  String?
  /// PLAIN TEXT explanation of the issue, straight from the report form.
  body      String
  status    ReportStatus @default(open)
  createdAt DateTime  @default(now())
  handledAt DateTime?

  /// The admin badge count and queue read.
  @@index([status])
  @@index([problemId])
  /// The per-user daily rate limit read.
  @@index([userId, createdAt])
}

/// Replaces git history as the record of who changed what.
model ProblemActivity {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problemId String       @db.Uuid
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Pseudonym snapshot at time of action; survives user deletion.
  userName  String?
  type      ActivityType
  /// For `updated`: which field changed, and its before/after.
  field     String?
  oldValue  String?
  newValue  String?
  /// For `voted`.
  vote      VoteKind?
  createdAt DateTime     @default(now())

  @@index([problemId])
  @@index([createdAt])
}

// Auth.js models.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// The ONLY public identity. Auto-assigned at sign-up and changeable in
  /// settings. The real OAuth name and avatar are never shown anywhere - see
  /// `src/lib/identity.ts`. Nullable only to cover the window before
  /// assignment runs.
  pseudonym String? @unique

  /// When the account was created. Added 2026-07-29; accounts that existed
  /// before then carry that date, not their real sign-up date.
  createdAt DateTime @default(now())

  /// Short self-description shown on the public profile. Plain text, capped
  /// at BIO_MAX characters (see src/lib/pseudonym.ts) - a line about who you
  /// are, not a homepage.
  bio String?

  /// Self-declared relationship to the mathematics: one of MEMBER_ROLES in
  /// src/lib/roles.ts. Unverifiable by construction and shown as a plain
  /// label, which is exactly why `verified` below is a separate, curator-set
  /// flag rather than a stronger wording of this one.
  role String?

  /// Profile links, a fixed named set rather than a free list (see
  /// src/lib/profile-links.ts): validated per kind, no open surface for link
  /// spam, and they double as the evidence the verification flow asks for.
  linkWebsite  String?
  linkArxiv    String?
  linkOrcid    String?
  linkGithub   String?
  linkLinkedin String?

  /// Curator-set: identity or affiliation was actually checked. Never
  /// self-serve. `verifiedNote` records what was checked, shown on hover.
  verified     Boolean @default(false)
  verifiedNote String?

  /// Banned accounts cannot sign in (denied in the signIn callback), and
  /// banning deletes their sessions - so with database sessions they lose all
  /// authenticated abilities at once. Curator-set; no UI.
  banned Boolean @default(false)

  /// Notification watermark: comments relevant to this user (on entries they
  /// submitted or commented on) newer than this are "unread". Computed on
  /// read against this timestamp - no notification rows, no fan-out writes.
  notificationsSeenAt DateTime @default(now())

  /// Inbox watermark, the counterpart of `notificationsSeenAt` for curator
  /// mail. Separate because the two are read in different places and a
  /// glance at the bell should not silently mark an unread letter as read.
  inboxSeenAt DateTime @default(now())

  accounts          Account[]
  sessions          Session[]
  votes             ProblemVote[]
  comments          Comment[]
  activities        ProblemActivity[]
  submittedProblems Problem[]         @relation("ProblemSubmitter")
  reports           ProblemReport[]
  messages          SiteMessage[]
  inbox             DirectMessage[]   @relation("DirectMessageRecipient")
  sentMessages      DirectMessage[]   @relation("DirectMessageSender")
}

/// A curator writing TO one reader. The mirror of SiteMessage, which carries
/// mail the other way.
///
/// This exists because every other channel the site had was either public
/// (comments) or truncated: a report or a rejection could be acted on, but the
/// only reply reached the reader as a 90-character snippet in the bell menu.
/// Deciding someone's submission or their bug report and then not being able
/// to explain why in full is the gap this closes.
///
/// Rows, unlike the comment notifications, which are computed against a
/// watermark with no rows at all. That asymmetry is deliberate: a comment
/// notification is a view over something already stored, whereas a message
/// has content of its own and nowhere else to live.
model DirectMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The reader it was written to. Cascades: an inbox is meaningless without
  /// its owner.
  userId String
  user   User   @relation("DirectMessageRecipient", fields: [userId], references: [id], onDelete: Cascade)

  /// The curator who wrote it, and a pseudonym snapshot in the same spirit as
  /// Comment.userName so a deleted account does not blank the signature.
  senderId   String?
  sender     User?   @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderName String?

  /// What prompted it: one of MESSAGE_KINDS in src/lib/messages.ts. Labels the
  /// message in the inbox; carries no behaviour.
  kind String

  /// The canned reason, when the curator picked one. Shown as the message's
  /// headline, with `body` underneath as the human part.
  reason String?

  /// PLAIN TEXT. Never rendered as markdown or HTML: this is curator mail, not
  /// a comment, and it should not become a formatting surface.
  body String

  /// The entry it concerns, when it concerns one. Nullable because a message
  /// about a deleted entry is still worth keeping, and because not every
  /// message has an entry behind it.
  problemId String?  @db.Uuid
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// The inbox read and the unread count, both by recipient and recency.
  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
